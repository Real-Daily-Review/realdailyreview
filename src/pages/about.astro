---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE, EDITORIAL_PRINCIPLES } from '@/config';
---

<BaseLayout title="About" description={`About ${SITE.name}.`}>
  <article class="article-body">
    <h1>About Real Daily Review</h1>
    <p style="font-size: 1.15rem; color: var(--color-muted);">{SITE.tagline}</p>

    <p>
      Real Daily Review is a conservative daily news publication covering Colorado state politics,
      elections, economic policy, and the issues that matter to Colorado's taxpayers, families, and
      businesses. Every weekday morning we publish a short brief plus standalone stories — focused,
      conservative, and Colorado-first.
    </p>

    <h2>Our perspective</h2>
    <p>
      We cover the news through a conservative lens: limited government, free markets, individual
      liberty, responsible energy development, and the rule of law. We don't pretend to be neutral
      when the left is wrong, and we don't soften the news to avoid making people uncomfortable.
      Colorado deserves a publication that tells it straight.
    </p>

    <h2>How we work</h2>
    <p>
      Stories are drafted by AI from multiple primary and secondary sources, then checked against
      our editorial principles below. We disclose AI involvement on every article, link every source,
      and label competing perspectives plainly when a topic is contested.
    </p>

    <h2>Our editorial principles</h2>
    <ol>
      {EDITORIAL_PRINCIPLES.map((p) => <li style="margin-bottom: 0.5rem;">{p}</li>)}
    </ol>

    <h2>Corrections</h2>
    <p>
      If something is wrong, tell us at <a href={`mailto:${SITE.feedbackEmail}`}>{SITE.feedbackEmail}</a>
      or via <a href="/feedback">the feedback form</a>. We append corrections in-line with date stamps;
      we never silently delete or edit a published claim away.
    </p>

    <h2>Contact</h2>
    <p>
      General: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a><br />
      Feedback: <a href={`mailto:${SITE.feedbackEmail}`}>{SITE.feedbackEmail}</a>
    </p>
  </article>
</BaseLayout>
