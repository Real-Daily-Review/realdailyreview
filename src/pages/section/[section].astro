---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const sections = ['politics', 'business', 'world', 'tech', 'culture', 'explainer', 'opinion'];
  return sections.map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const articles = (await getCollection('articles', ({ data }) => !data.draft && data.section === section))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const titleCase = (section ?? '').charAt(0).toUpperCase() + (section ?? '').slice(1);
---

<BaseLayout title={titleCase} description={`All ${titleCase} stories on Real Daily Review`}>
  <h1>{titleCase}</h1>
  {articles.length === 0 ? (
    <p>No stories yet in this section. Check back tomorrow morning.</p>
  ) : (
    <div>{articles.map((a) => <ArticleCard article={a} />)}</div>
  )}
</BaseLayout>
